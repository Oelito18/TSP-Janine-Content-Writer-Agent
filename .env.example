# Kopieer naar .env voor lokaal testen. Zet .env NOOIT in git.
# In productie horen deze waarden in GitHub → Settings → Secrets and variables → Actions.

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# E-mail (Resend). Alternatief: Postmark of de Gmail API.
RESEND_API_KEY=
APPROVER_EMAIL=          # het adres van Janine
SENDER_EMAIL=            # geverifieerd afzenderadres, bijv. agent@tsp-professionals.nl
