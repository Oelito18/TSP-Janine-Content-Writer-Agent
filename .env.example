# Kopieer naar .env voor lokaal testen. Zet .env NOOIT in git.
# In productie horen deze waarden in GitHub → Settings → Secrets and variables → Actions.

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# E-mail (Resend). Alternatief: Postmark of de Gmail API.
RESEND_API_KEY=

# Goedkeurders, komma-gescheiden. Elk concept gaat naar Janine én Tobias.
APPROVER_EMAILS=janine@voorbeeld.nl,tobias@voorbeeld.nl

# Oudere variant, blijft werken als je liever twee losse variabelen zet.
# Laat leeg als je APPROVER_EMAILS gebruikt.
APPROVER_EMAIL=
SECOND_APPROVER_EMAIL=

# Geverifieerd afzenderadres, bijv. agent@tsp-professionals.nl
SENDER_EMAIL=
